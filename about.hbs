<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Bunker Morse: third-party licences</title>
<style>
  body { font-family: sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; color: #222; }
  pre { white-space: pre-wrap; background: #f4f4f4; padding: 1em; }
  li { margin-bottom: 0.3em; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>Bunker Morse is MIT licensed (see LICENSE). The Windows exe contains the libraries below under these licences.
Generated with cargo-about from Cargo.lock for x86_64-pc-windows-msvc.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licences</h2>
{{#each licenses}}
<section id="{{id}}">
<h3>{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li>{{crate.name}} {{crate.version}}{{#if crate.repository}} (<a href="{{crate.repository}}">{{crate.repository}}</a>){{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
